<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mbox3pro.driver.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/mbox3d</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>com.mbox3pro.driver.daemon</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/var/log/mbox3d.log</string>
    <key>StandardOutPath</key>
    <string>/var/log/mbox3d.log</string>
</dict>
</plist>
