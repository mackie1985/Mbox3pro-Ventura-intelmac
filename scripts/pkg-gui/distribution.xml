<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Mbox 3 Pro driver (macOS 13, Intel / Apple Silicon beta)</title>
    <license file="license.txt" mime-type="text/plain"/>
    <readme file="readme.txt" mime-type="text/plain"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_anyVolume="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.mbox3pro.driver"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.mbox3pro.driver" visible="false">
        <pkg-ref id="com.mbox3pro.driver"/>
    </choice>
    <pkg-ref id="com.mbox3pro.driver" version="@VERSION@" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
